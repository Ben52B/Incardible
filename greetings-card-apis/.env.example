PORT=5000
MONGO_URL=mongodb+srv://...

# Public URLs
API_URL=https://api.incardible.com.au
APP_URL=https://incardible.com.au
# Comma-separated list of browser origins allowed to call the API
CORS_OPTIONS=https://incardible.com.au,https://www.incardible.com.au,https://admin.incardible.com.au,https://ar.incardible.com.au

# JWT
TOKEN_KEY=<long random secret>
TOKEN_EXPIRE=24h

# One-time key required in the x-admin-setup-key header to create an admin account.
# Leave empty to keep admin registration closed.
ADMIN_SETUP_KEY=

# Google sign-in (must match the website's GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Email (SMTP)
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
APP_NAME=Incardible
CONTACT_TO=

# Danger: enables the job that deletes PAID customisations (and their orders)
# after 90 days. Printed QR cards stop working when this runs. Keep unset.
ENABLE_PAID_DATA_CLEANUP=
