{
  "name": "incardible-ar-viewer",
  "version": "1.0.0",
  "private": true,
  "description": "Web-native AR viewer for Incardible cards (MindAR image tracking + three.js). Replaces the Unity WebGL viewer.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch --serve",
    "test": "node test/prepare.mjs && node test/e2e.mjs",
    "test:prepare": "node test/prepare.mjs"
  },
  "dependencies": {
    "mind-ar": "1.2.5",
    "three": "^0.160.1"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "playwright-core": "^1.47.0"
  }
}
